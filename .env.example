# Copie para .env e ajuste. O .env nunca vai para o git.

# --- Kill switch -----------------------------------------------------------
# true = nenhuma requisição sai, nem do worker já rodando (o .env é relido a
# cada requisição). Alternativa instantânea: python -m coleta.admin parar
SOSSEGO_COLETA_PAUSADA=false

# --- Coleta educada (padrões seguros; só afrouxe com motivo) ---------------
# Intervalo mínimo entre requisições à mesma loja, mais jitter aleatório 0..N s.
# Se o Crawl-delay do robots.txt for maior, vale o dele.
SOSSEGO_INTERVALO_MIN_S=5
SOSSEGO_JITTER_MAX_S=3
# Orçamento por loja (janela móvel). Estourou: a loja para e as outras seguem.
SOSSEGO_ORCAMENTO_HORA=60
SOSSEGO_ORCAMENTO_DIA=500
# Cache: nunca buscar a mesma URL duas vezes dentro do TTL.
SOSSEGO_TTL_BUSCA_S=1800
SOSSEGO_TTL_PRODUTO_S=3000
SOSSEGO_TIMEOUT_S=20
# Circuit breaker: pausa por reincidência (30 min, 2 h, 6 h). 3 sinais seguidos = desligada.
SOSSEGO_PAUSAS_BREAKER_S=1800,7200,21600
# Retry só em 5xx/timeout: esperas entre tentativas (máx. 2).
SOSSEGO_BACKOFF_RETRY_S=30,120

# Onde ficam bruto/, coleta.sqlite3 e coleta.log (padrão: ./dados)
# SOSSEGO_DIR_DADOS=

# --- Postgres (docker compose up -d db) ------------------------------------
# Porta 5434: a 5433 desta máquina já é de um Postgres nativo.
# SOSSEGO_DB_SENHA=sossego
# SOSSEGO_DATABASE_URL=postgresql://sossego:sossego@127.0.0.1:5434/sossego
# SOSSEGO_DATABASE_URL_TESTE=postgresql://sossego:sossego@127.0.0.1:5434/sossego_test

# --- Mercado Livre (API oficial, token de aplicação) -----------------------
# App criado em developers.mercadolivre.com.br. Segredo: só aqui, nunca no git.
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
